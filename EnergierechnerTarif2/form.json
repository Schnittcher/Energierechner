                        "second": 0
                    },
                    "edit": {
                        "type": "SelectTime"
                    }
                },
                {
                    "caption": "NT 2 until",
                    "name": "NtTo2",
                    "width": "90px",
                    "add": {
                        "hour": 0,
                        "minute": 0,
                        "second": 0
                    },
                    "edit": {
                        "type": "SelectTime"
                    }
                },
                {
                    "caption": "Weekend all day NT",
                    "name": "NtWeekend",
                    "width": "130px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Base price per year",
                    "name": "BasePrice",
                    "width": "130px",
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 4,
                        "minimum": 0
                    }
                },
                {
                    "caption": "Advance payment",
                    "name": "Advance",
                    "width": "120px",
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 2,
                        "minimum": 0
                    }
                },
                {
                    "caption": "Payments per year",
                    "name": "AdvanceCount",
                    "width": "120px",
                    "add": 12,
                    "edit": {
                        "type": "NumberSpinner",
                        "minimum": 0
                    }
                },
                {
                    "caption": "Gas conversion factor",
                    "name": "GasFactor",
                    "width": "150px",
                    "add": 1,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 4,
                        "minimum": 0
                    }
                },
                {
                    "caption": "Gas Z-number",
                    "name": "GasZ",
                    "width": "110px",
                    "add": 0.95,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 4,
                        "minimum": 0
                    }
                },
                {
                    "caption": "Gas calorific value",
                    "name": "GasCalorific",
                    "width": "140px",
                    "add": 10,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 4,
                        "minimum": 0
                    }
                }
            ],
            "values": []
        },
        {
            "type": "Label",
            "caption": "Low tariff (NT): enter up to two time windows per row (a window may cross midnight, e.g. 22:00 to 06:00). Leave 'from' and 'until' identical (e.g. both 00:00) for an unused window. 'Weekend all day NT' makes Saturday and Sunday low tariff for the whole day. A price (NT) of 0 uses the price (HT). Everything else is high tariff (HT)."
        },
        {
            "type": "Label",
            "caption": "Dynamic price: select a variable that holds the current price and is logged in the archive (aggregation type standard). The price used is variable value × unit factor + surcharge. Price (HT) is used as fallback for hours without price data (price (NT) in the low tariff times)."
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Instance is active"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "No tariff periods defined"
        }
    ]
}
