{
    "elements": [
        {
            "type": "Label",
            "caption": "Prices refer to one unit of the meter (kWh, m³ or liter). The tariff applies from the given date until the next entry."
        },
        {
            "type": "List",
            "name": "Periods",
            "caption": "Tariff periods",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "sort": {
                "column": "ValidFrom",
                "direction": "descending"
            },
            "columns": [
                {
                    "name": "Id",
                    "caption": "Id",
                    "width": "0px",
                    "visible": false,
                    "save": true,
                    "add": ""
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "150px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Supplier",
                    "name": "Supplier",
                    "width": "150px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Valid from",
                    "name": "ValidFrom",
                    "width": "110px",
                    "add": {
                        "year": 2025,
                        "month": 1,
                        "day": 1
                    },
                    "edit": {
                        "type": "SelectDate"
                    }
                },
                {
                    "caption": "Price (HT)",
                    "name": "PriceHT",
                    "width": "110px",
                    "add": 0.3,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 7,
                        "minimum": 0
                    }
                },
                {
                    "caption": "Price (NT)",
                    "name": "PriceNT",
                    "width": "110px",
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner",
                        "digits": 7,
                        "minimum": 0
                    }
                },
                {
                    "caption": "Price variable (dynamic)",
                    "name": "PriceVariable",
                    "width": "170px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Unit of the price variable",
                    "name": "PriceUnit",
                    "width": "170px",
                    "add": "EUR_KWH",
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "€/kWh (or €/m³, €/L)",
                                "value": "EUR_KWH"
                            },
                            {
                                "caption": "ct/kWh",
                                "value": "CT_KWH"
                            },
                            {
                                "caption": "€/MWh",
                                "value": "EUR_MWH"
                            }
                        ]
                    }
                },
                {
                    "caption": "Surcharge per unit",
                    "name": "Surcharge",
